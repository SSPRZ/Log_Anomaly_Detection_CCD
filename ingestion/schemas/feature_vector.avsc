{
  "type": "record",
  "name": "FeatureVector",
  "namespace": "io.lap.features",
  "doc": "One service-minute feature vector on logs.features (Section 4.3).",
  "fields": [
    {"name": "service", "type": "string"},
    {"name": "window_start", "type": "double"},
    {"name": "window_end", "type": "double"},
    {"name": "revision", "type": "int", "default": 0},
    {"name": "total_count", "type": "long"},
    {"name": "count_delta_week", "type": ["null", "long"], "default": null},
    {"name": "distinct_hosts", "type": "int"},
    {"name": "error_count", "type": "long"},
    {"name": "warn_count", "type": "long"},
    {"name": "error_ratio", "type": "double"},
    {"name": "fatal", "type": "int"},
    {"name": "unique_templates", "type": "int"},
    {"name": "new_templates", "type": "int"},
    {"name": "template_entropy", "type": "double"},
    {"name": "template_hist", "type": {"type": "array", "items": "long"}},
    {"name": "p50_latency_ms", "type": ["null", "double"], "default": null},
    {"name": "p95_latency_ms", "type": ["null", "double"], "default": null},
    {"name": "p99_latency_ms", "type": ["null", "double"], "default": null},
    {"name": "ratio_5xx", "type": "double"},
    {"name": "seconds_since_last", "type": "double"},
    {"name": "service_age_s", "type": "double", "default": 0},
    {"name": "max_event_ts", "type": ["null", "double"], "default": null},
    {"name": "template_counts", "type": {"type": "map", "values": "long"}},
    {"name": "top_templates", "type": {"type": "array", "items": {"type": "record", "name": "TemplateCount",
      "fields": [{"name": "template_id", "type": "string"}, {"name": "count", "type": "long"}]}}},
    {"name": "new_error_templates", "type": {"type": "array", "items": {"type": "record", "name": "NewErrorTemplate",
      "fields": [{"name": "template_id", "type": "string"}, {"name": "template", "type": "string"}, {"name": "count", "type": "long"}]}}, "default": []},
    {"name": "samples", "type": {"type": "array", "items": "string"}, "default": []},
    {"name": "is_canary", "type": "boolean", "default": false}
  ]
}
